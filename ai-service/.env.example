# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.

# mock   = 고정 JSON. 모델·API 키 없이 백엔드 연동 가능 (STEP 1)
# remote = 실제 YOLO + Claude VLM 추론
# cached = 이미지 해시 캐시만 사용. 발표 데모용 오프라인 경로
AI_MODE=mock

# mock 모드에서 시나리오 미지정 시 기본값
MOCK_DEFAULT_SCENARIO=pet_action_required

# --- VLM (STEP 4부터) ---
ANTHROPIC_API_KEY=
# Haiku는 라벨 색을 병 색으로 오인해 페트병 종류 판정이 흔들린다.
# 틀리면서 confidence 0.95를 보고해 신뢰도 기반 승급도 통하지 않는다.
# 근거: scripts/evaluate.py --item "투명 페트병"
VLM_PRIMARY_MODEL=claude-sonnet-5
VLM_FALLBACK_MODEL=claude-opus-4-8
VLM_TIMEOUT_SECONDS=20
# 기본(high+thinking)은 장당 15.4초. low는 5.8초이고 판정 결과는 같았다.
VLM_EFFORT=low
VLM_MAX_TOKENS=4096
VLM_MAX_EDGE=768

# --- STEP 3: 안전 필터 ---
# BlazeFace 가중치는 저장소에 포함되어 있다 (224KB).
# BlazeFace가 캔 뚜껑을 얼굴로 오인한다. 0.5에서 오탐 9.7%, 0.7에서 0%.
FACE_MIN_CONFIDENCE=0.7

# --- YOLO (STEP 2부터) ---
# dasibom_v1_best.pt 를 app/models/weights/ 에 넣는다
# 0.35(지시서 명시값)에서는 검출률 32.6%. 0.15에서 76.1%.
# 근거는 scripts/diagnose_threshold.py 참고.
YOLO_CONF_THRESHOLD=0.15
YOLO_IMGSZ=640
MULTIPLE_OBJECT_AREA_RATIO=0.5

# --- 전처리 (STEP 2부터) ---
CLIENT_MAX_EDGE=1024
MIN_BLUR_SCORE=40
MIN_BRIGHTNESS=40
CROP_PADDING=0.08

# --- 배출 기준 ---
DEFAULT_REGION_CODE=KR-43-CHEONGJU

# --- 버전 태그 (응답 processing 블록에 실린다) ---
MODEL_VERSION=yolo11n-dasibom-1.0.0
PROMPT_VERSION=child-feedback-0.1.0
RULE_VERSION=recycling-rules-2026-01

# 백엔드 메인 서버만 호출하므로 운영 시에는 좁힌다
CORS_ALLOW_ORIGINS=*
